# YouTube RSS Summarizer Configuration

# 1. YouTube Playlist Details
# Create a public or unlisted YouTube playlist and drop the URL here.
# Videos you want to summarize should simply be added to this playlist.
PLAYLIST_URL=https://www.youtube.com/playlist?list=PLcE_sBNWz5YQ

# 2. RSS Feed Metadata
FEED_PATH=feed.xml
FEED_TITLE="My Personal YouTube Read-Later Feed"
FEED_LINK="http://localhost:8090/feed"

# This prefix prevents RSS clients (like Feedly) from opening YouTube directly 
# when clicking titles, allowing them to render our generated text articles inline.
ARTICLE_LINK_PREFIX="http://localhost:8090/article/"

# 3. LLM Configuration (via LiteLLM)
# Choose any model supported by LiteLLM: e.g., openrouter/anthropic/claude-3-haiku, 
# vertex_ai/gemini-2.5-flash-lite, gpt-4o-mini, etc.
LLM_MODEL=vertex_ai/gemini-2.5-flash-lite

# Credentials (uncomment & populate whichever your chosen LLM provider requires)
# GOOGLE_APPLICATION_CREDENTIALS="~/.config/gcloud/application_default_credentials.json"
# OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key
# OPENROUTER_API_KEY=your-openrouter-key

# 4. Storage & Binaries Paths
PROCESSED_VIDEOS_PATH=processed_videos.json
YT_DLP_PATH=yt-dlp
